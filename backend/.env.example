# --- Base de datos ---
DATABASE_URL=sqlite:///./boardgames.db
# Producción (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/boardgames

# --- Seguridad JWT ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Cookie del Refresh Token (HttpOnly)
COOKIE_SECURE=false

# --- CORS (Frontend Flutter Web / React) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]
